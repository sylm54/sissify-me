<!-- Induction variant: guided breathing into trance. -->
<voice speaker='female' speed='0.9'>
  <tone preset='binaural_theta' frequency='200' volume='0.25'/>
    <background volume='0.3'>
        <loop loops='4'>
            Breathe in.
            <pause duration='2'/>
            Sissy Drops
            <pause duration='2'/>
            And let go.
            <pause duration='4'/>
        </loop>
    </background>
    With every breath you take, <pause duration='1'/>
    you feel yourself
    <background volume='0.2'>
        <loop loops='4'>
            Sissy Drops<pause duration='0.3'/>
        </loop>
    </background>
    becoming
    calmer <pause duration='0.3'/>
    softer <pause duration='0.3'/>
    heavier
    <pause duration='1'/>
    Each exhale carries away a little more of your thoughts,<pause duration='0.3'/>
    a little more of your tension<pause duration='0.4'/>
    leaving only my voice.
    <pause duration='1'/>
    <loop loops='3'>
        <volume value='@ramp(1.0, 0.7)'>
        Breathing deeper<pause duration='0.3'/>
        Sissy Drops<pause duration='0.3'/>
        drifting further<pause duration='0.3'/>
        Sissy Drops<pause duration='0.3'/>
        sinking softly into trance for me.
        </volume>
        <pause duration='2'/>
    </loop>
    Sissy Drops<pause duration='0.3'/>
    Good girl. You're almost there.
</voice>
